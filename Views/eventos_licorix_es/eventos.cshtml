@model IEnumerable<LICORIX_PROYECT.Models.Evento>
@{
    Layout = "_LicorixLayout";
    ViewData["Title"] = "Eventos - Licorix";
    var eventos = Model.ToList();
}\n\n<section class="relative h-[614px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDjQd7_bCt25MOnpfo-oGI9UxNSI1aFTuYdHu4iUln88Z7m9BK9dVse2fUYEnX_wxmpXrAAa1N3trs93qMJugkF7asSf22_pGYsgRfJpBj20yLJMN4tHa4NT7stzWs5I9FPw6IiyeWsvnd6vaMBWM1QqrKgFl8lV48odm_Teiq9yiwaDc6YmmG4zktdmwz_9FsdvqBVaFWxgVw2YhknCq9FxRHaOfqFQf2RdAbNauXHxh1v2GhfdbEN')"></div>
        <div class="absolute inset-0 bg-black/40"></div>
    </div>
    <div class="relative z-10 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full text-white">
        <span class="font-label-caps text-label-caps uppercase tracking-widest text-secondary-fixed mb-4 block">Experiencias Licorix</span>
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-6 max-w-2xl">Eventos Exclusivos & Talleres de Maestría</h1>
        <p class="font-body-lg text-body-lg max-w-xl opacity-90">Descubra el arte de la mixología y la profundidad de los destilados más finos a través de nuestras catas guiadas y eventos presenciales.</p>
    </div>
</section>\n\n<section class="py-12 border-b border-outline-variant bg-surface-container-low">
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="flex gap-4 overflow-x-auto pb-2 w-full md:w-auto scrollbar-hide">
            <button class="whitespace-nowrap px-6 py-2 bg-primary text-on-primary rounded-full font-label-caps text-label-caps uppercase">Todos los Eventos</button>
            <button class="whitespace-nowrap px-6 py-2 bg-white border border-outline text-on-background rounded-full font-label-caps text-label-caps uppercase hover:border-primary transition-all">Catas Presenciales</button>
            <button class="whitespace-nowrap px-6 py-2 bg-white border border-outline text-on-background rounded-full font-label-caps text-label-caps uppercase hover:border-primary transition-all">Talleres Coctelería</button>
            <button class="whitespace-nowrap px-6 py-2 bg-white border border-outline text-on-background rounded-full font-label-caps text-label-caps uppercase hover:border-primary transition-all">Lanzamientos</button>
        </div>
        <div class="flex items-center gap-4 w-full md:w-auto">
            <span class="font-label-caps text-label-caps text-outline uppercase">Ordenar por:</span>
            <select class="bg-transparent border-none border-b border-outline focus:ring-0 font-body-md text-body-md py-1 pr-8">
                <option>Próximas Fechas</option>
                <option>Más Populares</option>
                <option>Precio: Menor a Mayor</option>
            </select>
        </div>
    </div>
</section>\n\n<section class="py-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    @if (!eventos.Any())
    {
        <div class="text-center py-16">
            <span class="material-symbols-outlined text-6xl text-on-surface-variant">event_busy</span>
            <p class="font-headline-sm mt-4 text-primary">No hay eventos próximos.</p>
            <p class="text-on-surface-variant mt-2">Vuelve pronto, estamos preparando nuevas experiencias.</p>
        </div>
    }
    else
    {
        
        @if (eventos.Any())
        {
            var primero = eventos.First();
            <div class="md:col-span-8 mb-8 group event-card bg-white border border-outline-variant overflow-hidden flex flex-col md:flex-row">
                <div class="md:w-1/2 overflow-hidden relative h-64 md:h-auto">
                    <img class="event-image w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="@primero.ImagenURL" alt="@primero.Titulo" />
                    @if (primero.Destacado)
                    {
                        <div class="absolute top-4 left-4 bg-secondary text-white px-3 py-1 font-label-caps text-label-caps">MÁSTER CLASS</div>
                    }
                </div>
                <div class="md:w-1/2 p-8 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <span class="font-label-caps text-label-caps text-secondary-fixed-dim bg-primary px-2 py-1">@primero.Fecha.ToString("dd MMM yyyy")</span>
                            <span class="text-success font-label-caps text-label-caps text-green-600">@primero.PlazasRestantes PLAZAS RESTANTES</span>
                        </div>
                        <h3 class="font-headline-md text-headline-md mb-4 group-hover:text-secondary transition-colors">@primero.Titulo</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-6">@primero.Descripcion</p>
                        <div class="space-y-2">
                            <div class="flex items-center gap-2 text-on-surface-variant">
                                <span class="material-symbols-outlined text-sm">location_on</span>
                                <span class="font-body-md text-body-md">@primero.Lugar</span>
                            </div>
                            <div class="flex items-center gap-2 text-on-surface-variant">
                                <span class="material-symbols-outlined text-sm">schedule</span>
                                <span class="font-body-md text-body-md">@primero.Hora</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-6 flex items-center justify-between">
                        <span class="font-headline-sm text-headline-sm">Reservar plaza</span>
                        <button class="bg-primary text-white px-8 py-3 font-label-caps text-label-caps uppercase tracking-widest hover:bg-secondary transition-colors active:scale-95">Reservar</button>
                    </div>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
            @foreach (var e in eventos.Skip(1))
            {
                <div class="group event-card bg-white border border-outline-variant overflow-hidden">
                    <div class="h-64 overflow-hidden">
                        <img class="event-image w-full h-full object-cover transition-transform duration-700" src="@e.ImagenURL" alt="@e.Titulo" />
                    </div>
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <span class="font-label-caps text-label-caps text-outline uppercase">@e.Fecha.ToString("dd MMM yyyy")</span>
                            <span class="bg-secondary-container text-on-secondary-container px-2 py-1 font-label-caps text-label-caps">@e.Categoria.ToUpper()</span>
                        </div>
                        <h3 class="font-headline-sm text-headline-sm mb-3 group-hover:text-secondary transition-colors">@e.Titulo</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">@e.Descripcion</p>
                        <div class="flex items-center gap-2 text-on-surface-variant mb-4 text-sm">
                            <span class="material-symbols-outlined text-sm">location_on</span>
                            <span class="font-body-md text-body-md">@e.Lugar</span>
                        </div>
                        <div class="flex items-center justify-between pt-4 border-t border-outline-variant">
                            <span class="font-bold text-lg text-green-600">@e.PlazasRestantes plazas</span>
                            <button class="text-primary font-label-caps text-label-caps uppercase border-b border-primary pb-1 hover:text-secondary hover:border-secondary transition-all">Reservar</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>\n\n<section class="py-24 bg-tertiary-container text-on-tertiary">
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto text-center">
        <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-8">¿Desea un evento privado?</h2>
        <p class="font-body-lg text-body-lg max-w-2xl mx-auto mb-12 opacity-80">Diseñamos experiencias personalizadas para grupos corporativos o celebraciones íntimas. Desde catas a domicilio hasta talleres cerrados en nuestra boutique.</p>
        <a class="bg-white text-primary px-12 py-4 font-label-caps text-label-caps uppercase tracking-widest hover:bg-secondary hover:text-on-secondary transition-all inline-block" href="mailto:eventos@licorix.com">Solicitar Información</a>
    </div>
</section>