@model LICORIX_PROYECT.Models.ViewModels.PedidoViewModel
@{
    Layout = "_LicorixLayout";
    ViewData["Title"] = $"Pedido {Model.IdPedido} - Licorix";
}

<main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
    <section class="mb-12 border-l-4 border-primary pl-6">
        <span class="font-label-caps text-label-caps text-secondary block mb-2">MONITOR DE PEDIDO EN TIEMPO REAL</span>
        <h1 class="font-headline-md text-headline-md mb-1">Pedido @Model.IdPedido</h1>
        <p class="text-on-surface-variant font-body-md text-body-md">
            Realizado el @Model.Fecha.ToString("dd 'de' MMMM, yyyy") • @Model.Fecha.ToString("HH:mm")
            @if (!string.IsNullOrEmpty(Model.NombreCliente)) { <span>• @(Model.NombreCliente)</span> }
        </p>
    </section>

    <section class="mb-16">
        <div class="relative w-full overflow-x-auto scrollbar-hide pb-4">
            <div class="flex items-start justify-between min-w-[800px] relative">
                <div class="absolute top-4 left-0 w-full h-[2px] bg-surface-container-highest z-0"></div>
                <div class="absolute top-4 left-0 w-[75%] h-[2px] bg-secondary z-0 transition-all duration-1000 ease-in-out"></div>
                @foreach (var etapa in Model.Etapas)
                {
                    <div class="flex flex-col items-center text-center z-10 w-40 @(etapa.Activo ? "" : etapa.Completado ? "" : "opacity-40")">
                        @if (etapa.Completado)
                        {
                            <div class="w-8 h-8 rounded-sm bg-primary flex items-center justify-center mb-4 border border-primary shadow-sm">
                                <span class="material-symbols-outlined text-white text-[18px]" style="font-variation-settings: 'FILL' 1;">@etapa.Icono</span>
                            </div>
                            <span class="font-label-caps text-label-caps text-primary">@etapa.Titulo</span>
                            <span class="text-[10px] text-on-surface-variant mt-1">@etapa.HoraEstimada</span>
                        }
                        else if (etapa.Activo)
                        {
                            <div class="w-10 h-10 -mt-1 rounded-sm bg-secondary flex items-center justify-center mb-3 border border-secondary shadow-lg status-pulse">
                                <span class="material-symbols-outlined text-on-secondary text-[22px]" style="font-variation-settings: 'FILL' 1;">@etapa.Icono</span>
                            </div>
                            <span class="font-label-caps text-label-caps text-secondary font-bold">@etapa.Titulo</span>
                            <span class="text-[10px] text-secondary mt-1">Estimado @etapa.HoraEstimada</span>
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-sm bg-surface-container-highest flex items-center justify-center mb-4 border border-outline-variant">
                                <span class="material-symbols-outlined text-on-surface-variant text-[18px]">@etapa.Icono</span>
                            </div>
                            <span class="font-label-caps text-label-caps text-on-surface-variant">@etapa.Titulo</span>
                            <span class="text-[10px] text-on-surface-variant mt-1">@etapa.HoraEstimada</span>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <div class="lg:col-span-7 flex flex-col gap-6">
            <div class="bg-surface border border-outline-variant overflow-hidden relative group">
                <div class="absolute top-4 left-4 z-10 bg-white/90 backdrop-blur-md px-4 py-3 border border-outline-variant shadow-sm flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">moped</span>
                    </div>
                    <div>
                        <p class="font-label-caps text-[10px] text-on-surface-variant">REPARTIDOR</p>
                        <p class="font-body-md text-primary font-bold">Carlos M. está cerca</p>
                    </div>
                </div>
                
<div class="h-[450px] w-full relative">
    <iframe 
        src="https://maps.google.com/maps?q=-12.046374,-77.042793&z=13&output=embed" 
        class="w-full h-full border-0 grayscale contrast-125 opacity-90 hover:grayscale-0 transition-all duration-500" 
        allowfullscreen="" 
        loading="lazy">
    </iframe>
</div>\n\n                <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-md px-3 py-1 text-[10px] font-label-caps tracking-widest border border-outline-variant">SISTEMA DE RASTREO SATELITAL ACTIVO</div>
            </div>
            <div class="bg-primary-container p-6 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-2 h-2 bg-secondary rounded-full animate-pulse"></div>
                    <p class="text-white font-body-md">
                        Su pedido se encuentra a 1.2km de su destino.
                        @if (!string.IsNullOrEmpty(Model.Direccion)) { <span>Entrega en: <strong>@Model.Direccion</strong></span> }
                    </p>
                </div>
                <button class="hidden md:block text-secondary font-label-caps hover:underline">LLAMAR REPARTIDOR</button>
            </div>
        </div>

        <div class="lg:col-span-5 bg-surface-container-low p-8 border border-outline-variant flex flex-col gap-8">
            <div>
                <h3 class="font-headline-sm text-headline-sm mb-6 pb-4 border-b border-outline-variant">Resumen del Pedido</h3>
                <ul class="flex flex-col gap-6">
                    @foreach (var item in Model.Items)
                    {
                        <li class="flex gap-4">
                            <div class="w-20 h-24 bg-surface-container-highest flex-shrink-0 flex items-center justify-center p-2">
                                <img class="h-full w-auto object-contain" src="@(Url.Content(ImagenHelper.Url(item.ImagenURL, item.Nombre)))" alt="@item.Nombre" />
                            </div>
                            <div class="flex flex-col justify-center">
                                <p class="font-headline-sm text-[16px] leading-tight">@item.Nombre</p>
                                <p class="font-label-caps text-[10px] text-on-surface-variant mt-1">CANTIDAD: @item.Cantidad</p>
                                <p class="font-body-md text-primary font-bold mt-2">S/ @item.Subtotal.ToString("F2")</p>
                            </div>
                        </li>
                    }
                    @if (!Model.Items.Any())
                    {
                        <li class="text-on-surface-variant text-sm italic">No hay productos en este pedido.</li>
                    }
                </ul>
            </div>
            <div class="pt-6 border-t border-outline-variant flex flex-col gap-3">
                <div class="flex justify-between items-center mt-2">
                    <span class="font-headline-sm text-headline-sm">Total</span>
                    <span class="font-headline-sm text-headline-sm text-secondary">S/ @Model.Total.ToString("F2")</span>
                </div>
                <div class="flex justify-between text-on-surface-variant text-sm">
                    <span class="font-label-caps">MÉTODO DE PAGO</span>
                    <span class="font-body-md uppercase">@Model.MetodoPago</span>
                </div>
            </div>
            <a class="w-full bg-primary text-on-primary py-4 font-label-caps tracking-widest hover:bg-secondary transition-all flex items-center justify-center gap-2" asp-controller="Catalogo" asp-action="Index">
                <span class="material-symbols-outlined text-[18px]">storefront</span>
                SEGUIR COMPRANDO
            </a>
        </div>
    </div>
</main>