@model LICORIX_PROYECT.Models.ViewModels.CarritoViewModel
@{
    Layout = "_LicorixLayout";
    ViewData["Title"] = "Mi Carrito - Licorix";
}

<main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
    <div class="mb-12">
        <h1 class="font-headline-md text-headline-md text-primary mb-2">Tu Carrito de Selección</h1>
        <p class="font-body-md text-on-surface-variant">Revisa tu curaduría de licores premium antes de finalizar el pedido.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
        <div class="lg:col-span-8">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-16 border border-outline-variant bg-surface-container-low">
                    <span class="material-symbols-outlined text-6xl text-on-surface-variant">shopping_bag</span>
                    <p class="font-headline-sm mt-4 text-primary">Tu carrito está vacío.</p>
                    <p class="text-on-surface-variant mt-2">Aún no has agregado productos. Explora nuestro catálogo.</p>
                    <a class="inline-block mt-6 bg-primary text-on-primary px-6 py-3 font-label-caps text-label-caps hover:bg-secondary transition-colors" asp-controller="Catalogo" asp-action="Index">EXPLORAR CATÁLOGO</a>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-outline-variant">
                                <th class="py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase">Producto</th>
                                <th class="py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-center">Cantidad</th>
                                <th class="py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right">Precio</th>
                                <th class="py-4 font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase text-right">Subtotal</th>
                                <th class="py-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="border-b border-outline-variant group">
                                    <td class="py-8">
                                        <div class="flex items-center gap-4">
                                            <a asp-controller="DetalleProducto" asp-action="Index" asp-route-id="@item.IdProducto">
                                                <div class="w-24 h-24 bg-surface-container flex-shrink-0">
                                                    <img alt="@item.Nombre" class="w-full h-full object-cover" src="@(Url.Content(ImagenHelper.Url(item.ImagenURL, item.Nombre)))" />
                                                </div>
                                            </a>
                                            <div>
                                                <h3 class="font-headline-sm text-[18px] text-primary mb-1">
                                                    <a class="hover:text-secondary transition-colors" asp-controller="DetalleProducto" asp-action="Index" asp-route-id="@item.IdProducto">@item.Nombre</a>
                                                </h3>
                                                <p class="font-label-caps text-[10px] text-on-surface-variant uppercase">Stock: @item.Stock</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-8 text-center">
                                        <form asp-controller="Carrito" asp-action="Actualizar" method="post" id="formQty_@item.IdProducto" class="inline-flex items-center border border-outline-variant px-2 py-1">
                                            <input type="hidden" name="id" value="@item.IdProducto" />
                                            <button type="button" class="px-2 hover:text-secondary-container" onclick="cambiarCantidad(@item.IdProducto, -1, @item.Stock)">-</button>
                                            <input id="qty_@item.IdProducto" name="cantidad" class="w-12 text-center border-none bg-transparent focus:ring-0 font-body-md text-body-md" min="1" max="@item.Stock" type="number" value="@item.Cantidad" onchange="document.getElementById('formQty_@item.IdProducto').submit()" />
                                            <button type="button" class="px-2 hover:text-secondary-container" onclick="cambiarCantidad(@item.IdProducto, 1, @item.Stock)">+</button>
                                        </form>
                                    </td>
                                    <td class="py-8 text-right font-body-md text-body-md">S/ @item.Precio.ToString("F2")</td>
                                    <td class="py-8 text-right font-body-md font-bold text-body-md" id="subtotal_@item.IdProducto">S/ @item.Subtotal.ToString("F2")</td>
                                    <td class="py-8 text-right">
                                        <form asp-controller="Carrito" asp-action="Eliminar" method="post" class="inline">
                                            <input type="hidden" name="id" value="@item.IdProducto" />
                                            <button type="submit" class="text-on-surface-variant hover:text-error transition-colors" title="Eliminar">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                    <a class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-all font-label-caps text-label-caps uppercase tracking-wider" asp-controller="Catalogo" asp-action="Index">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Continuar Comprando
                    </a>
                    <form asp-controller="Carrito" asp-action="Limpiar" method="post">
                        <button type="submit" class="text-on-surface-variant font-label-caps text-label-caps uppercase tracking-wider hover:underline decoration-1 underline-offset-4">Vaciar Carrito</button>
                    </form>
                </div>
            }
        </div>

        @if (Model.Items.Any())
        {
            <aside class="lg:col-span-4 sticky top-24">
                <div class="bg-surface-container-low p-8 border border-outline-variant">
                    <h2 class="font-headline-sm text-headline-sm text-primary mb-6">Resumen del Pedido</h2>
                    <div class="space-y-4 mb-8">
                        <div class="flex justify-between font-body-md">
                            <span class="text-on-surface-variant">Subtotal (@Model.CantidadTotal items)</span>
                            <span class="text-primary">S/ @Model.Subtotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between font-body-md">
                            <span class="text-on-surface-variant">Envío Estimado</span>
                            <span class="text-primary">S/ @Model.Envio.ToString("F2")</span>
                        </div>
                    </div>
                    <div class="luxury-line mb-6"></div>
                    <div class="flex justify-between items-baseline mb-8">
                        <span class="font-headline-sm text-[20px] text-primary">Total</span>
                        <span class="font-headline-sm text-headline-sm text-primary">S/ @Model.Total.ToString("F2")</span>
                    </div>
                    <a class="w-full bg-primary text-on-primary py-5 font-label-caps text-label-caps tracking-[0.2em] uppercase hover:bg-secondary active:scale-[0.98] transition-all flex items-center justify-center gap-3" asp-controller="Pago_y_Envio" asp-action="Index">
                        Proceder al Pago Seguro
                        <span class="material-symbols-outlined">lock</span>
                    </a>
                    <div class="mt-6 flex justify-center gap-4 opacity-50">
                        <span class="material-symbols-outlined text-[24px]">credit_card</span>
                        <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
                        <span class="material-symbols-outlined text-[24px]">payments</span>
                    </div>
                </div>
                <div class="mt-6 p-4 border border-outline-variant bg-surface flex items-start gap-3">
                    <span class="material-symbols-outlined text-secondary">verified_user</span>
                    <div>
                        <p class="font-label-caps text-[11px] text-primary uppercase font-bold mb-1">Garantía Licorix</p>
                        <p class="font-body-md text-[13px] text-on-surface-variant leading-tight">Cada botella es verificada por nuestros sommeliers y transportada en condiciones climáticas controladas.</p>
                    </div>
                </div>
            </aside>
        }
    </div>
</main>