@model LICORIX_PROYECT.Models.ViewModels.PagoEnvioViewModel
@{
    Layout = "_LicorixLayout";
    ViewData["Title"] = "Finalizar Compra - Licorix";
}

<main class="flex-grow max-w-container-max mx-auto w-full px-margin-mobile md:px-margin-desktop py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7 space-y-12">
            <h1 class="font-headline-md text-headline-md mb-8 border-b border-outline-variant pb-4">Finalizar Compra</h1>

            <form asp-controller="Pago_y_Envio" asp-action="Procesar" method="post" id="checkout-form">
                
                <section class="step-transition">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold">1</span>
                        <h2 class="font-headline-sm text-headline-sm uppercase tracking-wider text-sm font-semibold">Datos de Envío</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                        <div class="col-span-full space-y-1">
                            <label asp-for="NombreCompleto" class="font-label-caps text-label-caps text-on-surface-variant"></label>
                            <input asp-for="NombreCompleto" type="text" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="Ej. Alejandro Martínez" />
                            <span asp-validation-for="NombreCompleto" class="text-error text-sm"></span>
                        </div>
                        <div class="col-span-full space-y-1">
                            <label asp-for="Direccion" class="font-label-caps text-label-caps text-on-surface-variant"></label>
                            <input asp-for="Direccion" type="text" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="Calle, número, piso, departamento" />
                            <span asp-validation-for="Direccion" class="text-error text-sm"></span>
                        </div>
                        <div class="space-y-1">
                            <label asp-for="Ciudad" class="font-label-caps text-label-caps text-on-surface-variant"></label>
                            <input asp-for="Ciudad" type="text" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="Ej. Lima" />
                            <span asp-validation-for="Ciudad" class="text-error text-sm"></span>
                        </div>
                        <div class="space-y-1">
                            <label asp-for="Telefono" class="font-label-caps text-label-caps text-on-surface-variant"></label>
                            <input asp-for="Telefono" type="tel" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="Ej. +51 900 000 000" />
                            <span asp-validation-for="Telefono" class="text-error text-sm"></span>
                        </div>
                        <div class="col-span-full space-y-1">
                            <label asp-for="Email" class="font-label-caps text-label-caps text-on-surface-variant"></label>
                            <input asp-for="Email" type="email" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="Ej. tu@correo.com" />
                            <span asp-validation-for="Email" class="text-error text-sm"></span>
                        </div>
                    </div>
                </section>

                
                <section class="step-transition pt-8 border-t border-outline-variant mt-8">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold">2</span>
                        <h2 class="font-headline-sm text-headline-sm uppercase tracking-wider text-sm font-semibold">Método de Envío</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <label class="relative flex cursor-pointer rounded-lg border border-outline-variant p-4 hover:border-secondary transition-all @(Model.MetodoEnvio == "standard" ? "border-secondary" : "")">
                            <input type="radio" asp-for="MetodoEnvio" value="standard" class="mt-1 h-4 w-4 text-secondary focus:ring-secondary border-outline-variant" />
                            <div class="ml-4">
                                <span class="block font-bold text-on-surface">Estándar</span>
                                <span class="mt-1 block text-sm text-on-surface-variant">3-5 días laborables</span>
                            </div>
                            <span class="ml-auto font-bold">$4.90</span>
                        </label>
                        <label class="relative flex cursor-pointer rounded-lg border border-outline-variant p-4 hover:border-secondary transition-all @(Model.MetodoEnvio == "express" ? "border-secondary" : "")">
                            <input type="radio" asp-for="MetodoEnvio" value="express" class="mt-1 h-4 w-4 text-secondary focus:ring-secondary border-outline-variant" />
                            <div class="ml-4">
                                <span class="block font-bold text-on-surface">Express</span>
                                <span class="mt-1 block text-sm text-on-surface-variant">24-48 horas</span>
                            </div>
                            <span class="ml-auto font-bold">$9.90</span>
                        </label>
                    </div>
                </section>

                
                <section class="step-transition pt-8 border-t border-outline-variant mt-8">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold">3</span>
                        <h2 class="font-headline-sm text-headline-sm uppercase tracking-wider text-sm font-semibold">Método de Pago</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <label class="relative flex cursor-pointer rounded-lg border border-outline-variant p-4 hover:border-secondary transition-all @(Model.MetodoPago == "tarjeta" ? "border-secondary" : "")">
                            <input type="radio" asp-for="MetodoPago" value="tarjeta" class="mt-1 h-4 w-4 text-secondary focus:ring-secondary border-outline-variant" />
                            <div class="ml-4">
                                <span class="block font-bold text-on-surface text-sm">Tarjeta</span>
                            </div>
                            <span class="ml-auto material-symbols-outlined text-on-surface-variant">credit_card</span>
                        </label>
                        <label class="relative flex cursor-pointer rounded-lg border border-outline-variant p-4 hover:border-secondary transition-all @(Model.MetodoPago == "yape" ? "border-secondary" : "")">
                            <input type="radio" asp-for="MetodoPago" value="yape" class="mt-1 h-4 w-4 text-secondary focus:ring-secondary border-outline-variant" />
                            <div class="ml-4">
                                <span class="block font-bold text-on-surface text-sm">Yape / Plin</span>
                            </div>
                            <span class="ml-auto material-symbols-outlined text-on-surface-variant">phone_android</span>
                        </label>
                        <label class="relative flex cursor-pointer rounded-lg border border-outline-variant p-4 hover:border-secondary transition-all @(Model.MetodoPago == "transferencia" ? "border-secondary" : "")">
                            <input type="radio" asp-for="MetodoPago" value="transferencia" class="mt-1 h-4 w-4 text-secondary focus:ring-secondary border-outline-variant" />
                            <div class="ml-4">
                                <span class="block font-bold text-on-surface text-sm">Transferencia</span>
                            </div>
                            <span class="ml-auto material-symbols-outlined text-on-surface-variant">account_balance</span>
                        </label>
                    </div>

                    <div class="bg-surface-container-low p-6 space-y-6">
                        <div class="space-y-1">
                            <label asp-for="NumeroTarjeta" class="font-label-caps text-label-caps text-on-surface-variant">NÚMERO DE TARJETA (SIMULADO)</label>
                            <input asp-for="NumeroTarjeta" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 pr-10 focus:border-primary transition-colors" placeholder="0000 0000 0000 0000" />
                        </div>
                        <div class="grid grid-cols-2 gap-gutter">
                            <div class="space-y-1">
                                <label asp-for="Vencimiento" class="font-label-caps text-label-caps text-on-surface-variant">EXPIRACIÓN (MM/AA)</label>
                                <input asp-for="Vencimiento" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="MM / YY" />
                            </div>
                            <div class="space-y-1">
                                <label asp-for="Cvv" class="font-label-caps text-label-caps text-on-surface-variant">CÓDIGO CVV</label>
                                <input asp-for="Cvv" class="w-full border-0 border-b border-outline-variant bg-transparent py-2 focus:border-primary transition-colors" placeholder="123" />
                            </div>
                        </div>
                    </div>
                </section>

                <button type="submit" class="mt-12 w-full bg-primary text-on-primary py-5 font-label-caps text-label-caps text-sm tracking-widest hover:bg-secondary active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                    FINALIZAR COMPRA
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
                <p class="text-[11px] text-on-surface-variant text-center mt-4 italic">
                    Al hacer clic en "Finalizar Compra", aceptas nuestros términos de servicio.
                </p>
            </form>
        </div>

        
        <div class="lg:col-span-5">
            <div class="sticky top-28 bg-surface-container-lowest border border-outline-variant p-8 shadow-sm">
                <h3 class="font-headline-sm text-headline-sm mb-6 pb-4 border-b border-outline-variant">Resumen del Pedido</h3>
                <div class="space-y-6 mb-8 max-h-64 overflow-y-auto pr-2">
                    @foreach (var item in Model.Items)
                    {
                        <div class="flex gap-4">
                            <div class="w-20 h-20 bg-surface-container flex-shrink-0 flex items-center justify-center overflow-hidden border border-outline-variant">
                                <img class="w-full h-full object-cover" src="@(Url.Content(ImagenHelper.Url(item.ImagenURL, item.Nombre)))" alt="@item.Nombre" />
                            </div>
                            <div class="flex-grow">
                                <h4 class="font-headline-sm text-base">@item.Nombre</h4>
                                <p class="text-label-caps text-on-surface-variant mt-1">@item.Cantidad × S/ @item.Precio.ToString("F2")</p>
                                <p class="font-bold mt-1 text-primary">S/ @item.Subtotal.ToString("F2")</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="space-y-3 border-t border-outline-variant pt-6 mb-8">
                    <div class="flex justify-between text-body-md">
                        <span class="text-on-surface-variant">Subtotal</span>
                        <span>S/ @Model.Subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-body-md">
                        <span class="text-on-surface-variant">Envío</span>
                        <span>S/ @Model.Envio.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between items-end pt-4 border-t border-outline-variant mt-4">
                        <span class="font-headline-sm text-lg">TOTAL</span>
                        <span class="font-headline-md text-3xl text-primary">S/ @Model.Total.ToString("F2")</span>
                    </div>
                </div>
                <div class="flex justify-center gap-3 opacity-50">
                    <span class="material-symbols-outlined text-[24px]">credit_card</span>
                    <span class="material-symbols-outlined text-[24px]">shield</span>
                    <span class="material-symbols-outlined text-[24px]">lock</span>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}