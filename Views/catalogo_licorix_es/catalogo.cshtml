@model LICORIX_PROYECT.Models.ViewModels.CatalogoViewModel
@{
    Layout = "_LicorixLayout";
    ViewData["Title"] = "Catálogo - Licorix";
    string FiltroActivo(int? id) => (Model.IdCategoriaSeleccionada == id) ? "font-semibold text-primary" : "font-body-md text-body-md group-hover:text-secondary transition-colors";
}

<main class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
    <div class="flex flex-col md:flex-row gap-gutter">

        
        <aside class="w-full md:w-64 flex-shrink-0 space-y-8">
            <div>
                <h2 class="font-label-caps text-label-caps text-primary border-b border-outline-variant pb-2 mb-4 uppercase">Tipo de Licor</h2>
                <div class="space-y-3">
                    <a class="flex items-center group cursor-pointer @(Model.IdCategoriaSeleccionada == null ? "font-semibold text-primary" : "")" asp-controller="Catalogo" asp-action="Index">
                        <span class="ml-3 font-body-md text-body-md group-hover:text-secondary transition-colors">Todos</span>
                    </a>
                    @foreach (var c in Model.Categorias)
                    {
                        <a class="flex items-center group cursor-pointer" asp-controller="Catalogo" asp-action="Index" asp-route-idCategoria="@c.IdCategoria">
                            <span class="ml-3 @FiltroActivo(c.IdCategoria)">@c.Nombre</span>
                        </a>
                    }
                </div>
            </div>

            <div>
                <h2 class="font-label-caps text-label-caps text-primary border-b border-outline-variant pb-2 mb-4 uppercase">Rango de Precio</h2>
                <form method="get" asp-controller="Catalogo" asp-action="Index" class="px-2 space-y-3">
                    @if (Model.IdCategoriaSeleccionada.HasValue)
                    {
                        <input type="hidden" name="idCategoria" value="@Model.IdCategoriaSeleccionada.Value" />
                    }
                    <div class="flex gap-2">
                        <input type="number" name="precioMin" value="@Model.PrecioMin" min="0" step="5" placeholder="Mín"
                               class="w-1/2 border border-outline-variant bg-transparent py-1 px-2 text-sm" />
                        <input type="number" name="precioMax" value="@Model.PrecioMax" min="0" step="5" placeholder="Máx"
                               class="w-1/2 border border-outline-variant bg-transparent py-1 px-2 text-sm" />
                    </div>
                    <button type="submit" class="w-full bg-primary text-on-primary py-2 font-label-caps text-label-caps hover:bg-secondary transition-colors">APLICAR</button>
                </form>
            </div>

            <div>
                <h2 class="font-label-caps text-label-caps text-primary border-b border-outline-variant pb-2 mb-4 uppercase">Ordenar</h2>
                <form method="get" asp-controller="Catalogo" asp-action="Index">
                    @if (Model.IdCategoriaSeleccionada.HasValue)
                    {
                        <input type="hidden" name="idCategoria" value="@Model.IdCategoriaSeleccionada.Value" />
                    }
                    <select name="ordenar" onchange="this.form.submit()" class="w-full border border-outline-variant bg-transparent py-2 px-2 font-body-md text-body-md">
                        <option value="nombre" selected="@(Model.Orden == "nombre")">Nombre (A-Z)</option>
                        <option value="precio-asc" selected="@(Model.Orden == "precio-asc")">Precio: menor a mayor</option>
                        <option value="precio-desc" selected="@(Model.Orden == "precio-desc")">Precio: mayor a menor</option>
                    </select>
                </form>
            </div>
        </aside>

        
        <section class="flex-1">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 pb-4 border-b border-outline-variant">
                <div>
                    <h1 class="font-headline-md text-headline-md text-primary mb-1">
                        @(Model.IdCategoriaSeleccionada.HasValue
                            ? Model.Categorias.FirstOrDefault(c => c.IdCategoria == Model.IdCategoriaSeleccionada)?.Nombre
                            : "Catálogo de Destilados")
                    </h1>
                    <p class="font-body-md text-sm text-on-surface-variant">
                        Mostrando @((Model.CurrentPage-1)*Model.PageSize + 1) - @Math.Min(Model.CurrentPage*Model.PageSize, Model.TotalCount) de @Model.TotalCount producto(s)
                    </p>
                </div>
            </div>

            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-12 gap-x-gutter">
                @if (!Model.Productos.Any())
                {
                    <div class="col-span-full text-center py-16">
                        <span class="material-symbols-outlined text-6xl text-on-surface-variant">search_off</span>
                        <p class="font-headline-sm mt-4 text-primary">No encontramos productos.</p>
                        <p class="text-on-surface-variant mt-2">Prueba con otro filtro o limpia la búsqueda.</p>
                        <a class="inline-block mt-6 bg-primary text-on-primary px-6 py-3 font-label-caps text-label-caps hover:bg-secondary transition-colors" asp-controller="Catalogo" asp-action="Index">VER TODO EL CATÁLOGO</a>
                    </div>
                }
                @foreach (var p in Model.Productos)
                {
                    <div class="product-card-hover group relative">
                        <div class="aspect-[3/4] bg-surface-container-low relative overflow-hidden flex items-center justify-center p-8">
                            <a asp-controller="DetalleProducto" asp-action="Index" asp-route-id="@p.IdProducto">
                                <img class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" src="@(Url.Content(ImagenHelper.Url(p.ImagenURL, p.Nombre)))" alt="@p.Nombre" />
                            </a>
                            @if (p.Stock > 0)
                            {
                                <div class="absolute top-4 right-4">
                                    <span class="bg-secondary text-on-secondary font-label-caps text-[10px] px-2 py-1 tracking-widest">EN STOCK</span>
                                </div>
                            }
                            else
                            {
                                <div class="absolute top-4 right-4">
                                    <span class="bg-error text-on-error font-label-caps text-[10px] px-2 py-1 tracking-widest">AGOTADO</span>
                                </div>
                            }
                            <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                <input type="hidden" name="id" value="@p.IdProducto" />
                                <input type="hidden" name="cantidad" value="1" />
                                <button type="submit" class="add-to-cart-btn absolute bottom-0 left-0 right-0 bg-primary text-on-primary font-label-caps text-xs py-4 opacity-0 transform translate-y-4 transition-all duration-300 hover:bg-secondary">
                                    AÑADIR A LA CESTA
                                </button>
                            </form>
                        </div>
                        <div class="mt-4 flex flex-col gap-1">
                            <span class="font-label-caps text-[10px] text-on-surface-variant">@p.GraduacionAlcoholica.ToString("F1")% ALC. VOL.</span>
                            <h3 class="font-headline-sm text-lg text-primary">
                                <a class="hover:text-secondary transition-colors" asp-controller="DetalleProducto" asp-action="Index" asp-route-id="@p.IdProducto">@p.Nombre</a>
                            </h3>
                            <p class="font-body-md text-base font-bold text-primary mt-1">S/ @p.Precio.ToString("F2")</p>
                        </div>
                    </div>
                }
            </div>

            
            @{
                var currentPage = Model.CurrentPage;
                var totalPages = Model.TotalPages;
            }
            <div class="mt-8 flex items-center justify-center gap-2">
                @if (currentPage > 1)
                {
                    <a asp-controller="Catalogo" asp-action="Index" asp-route-page="@(currentPage-1)" asp-route-idCategoria="@Model.IdCategoriaSeleccionada" asp-route-texto="@Model.TextoBusqueda" asp-route-ordenar="@Model.Orden" class="px-3 py-1 border rounded hover:bg-surface">&larr; Anterior</a>
                }
                else
                {
                    <span class="px-3 py-1 border rounded opacity-50">&larr; Anterior</span>
                }

                <div class="hidden md:flex items-center gap-1">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="px-3 py-1 border rounded bg-primary text-on-primary font-bold">@i</span>
                        }
                        else
                        {
                            <a asp-controller="Catalogo" asp-action="Index" asp-route-page="@i" asp-route-idCategoria="@Model.IdCategoriaSeleccionada" asp-route-texto="@Model.TextoBusqueda" asp-route-ordenar="@Model.Orden" class="px-3 py-1 border rounded hover:bg-surface">@i</a>
                        }
                    }
                </div>

                @if (currentPage < totalPages)
                {
                    <a asp-controller="Catalogo" asp-action="Index" asp-route-page="@(currentPage+1)" asp-route-idCategoria="@Model.IdCategoriaSeleccionada" asp-route-texto="@Model.TextoBusqueda" asp-route-ordenar="@Model.Orden" class="px-3 py-1 border rounded hover:bg-surface">Siguiente &rarr;</a>
                }
                else
                {
                    <span class="px-3 py-1 border rounded opacity-50">Siguiente &rarr;</span>
                }
            </div>
        </section>
    </div>
</main>
