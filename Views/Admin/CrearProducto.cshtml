@model LICORIX_PROYECT.Models.Producto
@{
    Layout = "_LicorixLayout";
    ViewData["Title"] = "Crear Producto - Admin";
    var categorias = ViewBag.Categorias as List<LICORIX_PROYECT.Models.Categoria> ?? new List<LICORIX_PROYECT.Models.Categoria>();
    var marcas = ViewBag.Marcas as List<LICORIX_PROYECT.Models.Marca> ?? new List<LICORIX_PROYECT.Models.Marca>();
}

<main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="font-headline-md text-headline-md text-primary">Agregar Producto</h1>
            <p class="text-on-surface-variant">Rellena los datos para agregar un producto al catálogo.</p>
        </div>
        <a class="bg-primary text-on-primary px-6 py-3" asp-controller="Admin" asp-action="Stock">Volver a Stock</a>
    </div>

    <form asp-controller="Admin" asp-action="CrearProducto" method="post">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm">Nombre</label>
                <input name="Nombre" value="@Model.Nombre" class="w-full border px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm">Precio</label>
                <input name="Precio" type="number" step="0.01" value="@Model.Precio" class="w-full border px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm">Stock</label>
                <input name="Stock" type="number" value="@Model.Stock" class="w-full border px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm">Imagen URL / filename</label>
                <input name="ImagenURL" value="@Model.ImagenURL" class="w-full border px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm">Graduación Alcoholica</label>
                <input name="GraduacionAlcoholica" type="number" step="0.01" value="@Model.GraduacionAlcoholica" class="w-full border px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm">Volumen (ml)</label>
                <input name="VolumenML" type="number" value="@Model.VolumenML" class="w-full border px-3 py-2" />
            </div>
            <div>
                <label class="block text-sm">Categoria</label>
                <select name="IdCategoria" class="w-full border px-3 py-2">
                    @foreach (var c in categorias)
                    {
                        <option value="@c.IdCategoria">@c.Nombre</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm">Marca</label>
                <select name="IdMarca" class="w-full border px-3 py-2">
                    @foreach (var m in marcas)
                    {
                        <option value="@m.IdMarca">@m.Nombre</option>
                    }
                </select>
            </div>

            <div class="md:col-span-2">
                <label class="block text-sm">Descripción</label>
                <textarea name="Descripcion" class="w-full border px-3 py-2">@Model.Descripcion</textarea>
            </div>
        </div>

        <div class="mt-6">
            <button type="submit" class="bg-primary text-on-primary px-6 py-3">Agregar Producto</button>
        </div>
    </form>
</main>